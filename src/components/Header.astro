---
import Logo from './Logo.astro';
import ToolSearch from './ToolSearch.astro';
import { categories, toolsByCategory } from '../data/tools';

interface Props {
  landing?: boolean;
}
const { landing = false } = Astro.props;

const catSlug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const CAT_BLURB: Record<string, string> = {
  Text: 'Count, convert, compare and transform text.',
  Developer: 'Format, encode, validate and generate code.',
  Image: 'Edit, resize, compress and convert images.',
  PDF: 'Merge, split, convert and extract from PDFs.',
  'Audio & Video': 'Convert, compress and extract media.',
  Converters: 'Convert between hundreds of file formats.',
  Calculators: 'Crunch numbers for finance, health and math.',
  Generators: 'Create passwords, QR codes, data and more.',
  Security: 'Hashes, keys, passwords and validation.',
  'Device & Sensors': 'Test your device, input and connection.',
};
const CAT_FG: Record<string, string> = {
  Text: 'text-sky-400',
  Developer: 'text-violet-400',
  Image: 'text-emerald-400',
  Converters: 'text-amber-400',
  Calculators: 'text-rose-400',
  Generators: 'text-fuchsia-400',
  Security: 'text-teal-400',
  PDF: 'text-red-400',
  'Audio & Video': 'text-indigo-400',
  'Device & Sensors': 'text-cyan-400',
};
const CAT_EMOJI: Record<string, string> = {
  Text: '🔤',
  Developer: '🖥️',
  Image: '🎨',
  Converters: '🔀',
  Calculators: '🧮',
  Generators: '🪄',
  Security: '🛡️',
  PDF: '📚',
  'Audio & Video': '🎥',
  'Device & Sensors': '📟',
};
const TWEMOJI_BASE = 'https://cdn.jsdelivr.net/gh/jdecked/twemoji@15.1.0/assets/svg/';
const twemojiUrl = (emoji: string): string => {
  const chars = emoji.indexOf('‍') < 0 ? emoji.replace(/️/g, '') : emoji;
  return TWEMOJI_BASE + Array.from(chars).map((ch) => ch.codePointAt(0)!.toString(16)).join('-') + '.svg';
};
const CAT_MENU = categories.map((c) => {
  const all = toolsByCategory(c);
  return {
    name: c,
    slug: catSlug(c),
    count: all.length,
    blurb: CAT_BLURB[c] ?? '',
    fg: CAT_FG[c] ?? 'text-ink-tertiary',
    emoji: twemojiUrl(CAT_EMOJI[c] ?? '🔧'),
    featured: all.slice(0, 4),
    tools: all,
  };
});

// ponytail: the mega-menu is desktop-only (hidden lg:flex) and hover-gated, but
// rendering all ~627 tool links + inline SVGs inline made the doc 660KB — 84% of
// it dead weight on mobile. Emit the tool data as JSON and build the grid
// client-side on first hover instead. Footer still ships the links for SEO.
// name/emoji are here for the mobile panel's section headings — the desktop rail renders those in
// markup, but mobile builds the whole thing from this blob.
const MEGA_TOOLS = CAT_MENU.map((cat) => ({
  name: cat.name,
  slug: cat.slug,
  emoji: cat.emoji,
  fg: cat.fg,
  tools: cat.tools.map((t) => [t.slug, t.name, t.icon]),
}));
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/85 backdrop-blur-md">
  <nav class="container-page flex h-14 items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      {landing ? (
        <a href="/" class="inline-flex items-center gap-2 no-underline" aria-label="ToolSilk home">
          <img src="/favicon.svg" width="24" height="24" alt="" aria-hidden="true" class="rounded-[5px]" />
          <span class="hidden font-display font-semibold text-[15px] tracking-[-0.01em] text-ink lg:inline">
            Tool<span class="text-ink-subtle">Silk</span>
          </span>
        </a>
      ) : (
        <>
          <button
            id="sidebar-toggle-btn"
            class="btn btn-tertiary p-2 cursor-pointer"
            aria-label="Toggle sidebar"
            title="Toggle sidebar"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="6" x2="20" y2="6" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="18" x2="20" y2="18" />
            </svg>
          </button>
          <!-- Wordmark hides below lg so "All Tools" can take that slot; the favicon still links home. -->
          <Logo class="[&>span]:hidden lg:[&>span]:inline" />
        </>
      )}

      <!-- Mobile/tablet tool browser. The desktop mega-menu is hover-gated and hidden below lg,
           so small screens had no way to see what tools exist. Same JSON blob, different shell. -->
      <button
        id="mtools-open"
        type="button"
        class="ml-1 inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-[13px] font-medium text-ink-subtle hover:bg-surface-2 hover:text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mtools-panel"
      >
        All Tools
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>

    <div class="hidden items-center gap-1 lg:flex">
      <a href="/about" class="btn btn-tertiary">About</a>
      <a href="/feedback" class="btn btn-tertiary">Feedback</a>
      <a href="/contact" class="btn btn-tertiary">Contact Us</a>

      <div class="nav-tools">
        <a href="/tools" class="btn btn-tertiary inline-flex items-center gap-1">
          Tools
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </a>

        
        <div class="nav-mega">
          <div class="container-page pt-0 pb-5">
            <div class="nav-mega-card flex gap-6 rounded-xl border border-hairline bg-surface-2 shadow-2xl">
              
              <div class="w-44 flex-none border-r border-hairline p-2">
                {CAT_MENU.map((cat, i) => (
                  <button type="button" class="nav-rail flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm text-ink-subtle hover:bg-surface-3 hover:text-ink" data-cat={i} aria-controls={`mega-${i}`}>
                    <img src={cat.emoji} alt="" aria-hidden="true" loading="lazy" width="16" height="16" class="flex-none" />
                    <span>{cat.name}</span>
                  </button>
                ))}
              </div>


              <div class="min-w-0 flex-1 p-4 pr-5">
                {CAT_MENU.map((cat, i) => (
                  <div class="nav-panel h-80 overflow-y-auto" id={`mega-${i}`} data-panel={i} hidden={i !== 0}>
                    <div class="nav-grid grid grid-cols-2 gap-x-5 gap-y-0.5 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"></div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-6">
      <button
        type="button"
        class="theme-toggle btn btn-tertiary"
        aria-label="Toggle color theme"
        title="Toggle light / dark theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>
      <div class="hidden md:block">
        <ToolSearch variant="compact" id="tool-search-header" />
      </div>
    </div>
  </nav>

  <script is:inline type="application/json" id="mega-data" set:html={JSON.stringify(MEGA_TOOLS)} />
</header>

<!-- Mobile tool browser panel. Empty on purpose: the grid is built client-side on first open from
     #mega-data, same as the desktop mega-menu. Inlining ~627 links would add ~550KB to every page.
     Kept OUTSIDE <header> — the header's backdrop-blur makes it a containing block for fixed
     descendants, which would collapse inset-0 to the 56px nav bar. -->
<div id="mtools-panel" class="fixed inset-0 z-[70] hidden lg:hidden" role="dialog" aria-modal="true" aria-label="All tools">
  <div id="mtools-backdrop" class="absolute inset-0 bg-black/60"></div>
  <div class="absolute inset-x-0 top-0 flex max-h-[100dvh] flex-col border-b border-hairline bg-canvas shadow-2xl">
    <div class="flex items-center justify-between gap-3 border-b border-hairline px-4 py-3">
      <span class="text-[13px] font-medium text-ink">All Tools</span>
      <button
        id="mtools-close"
        type="button"
        class="-mr-1 rounded-md p-1.5 text-ink-subtle hover:bg-surface-2 hover:text-ink"
        aria-label="Close tool menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="mtools-body" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-4"></div>
  </div>
</div>

<style>

  .theme-toggle, #sidebar-toggle-btn {
    padding: 0;
    min-height: 0;
    border: 0;
    background: transparent;
  }
  .theme-toggle:hover, #sidebar-toggle-btn:hover { background: transparent; color: var(--color-ink-muted); }
  #sidebar-toggle-btn:focus-visible { outline: none; }
  .theme-toggle .icon-moon { display: none; }
  :global(html[data-theme='light']) .theme-toggle .icon-sun { display: none; }
  :global(html[data-theme='light']) .theme-toggle .icon-moon { display: inline; }

  
  .nav-tools { position: static; }
  .nav-mega {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 60;
  }
  .nav-mega.open { display: block; }
  .nav-rail[aria-current="true"] {
    background: var(--color-surface-3, #18191a);
    color: var(--color-ink, #f7f8f8);
  }
</style>

<script>

  const dispatchToggle = () => {
    window.dispatchEvent(new CustomEvent('toggle-sidebar'));
  };

  document.getElementById('sidebar-toggle-btn')?.addEventListener('click', dispatchToggle);
  document.getElementById('nav-toggle')?.addEventListener('click', dispatchToggle);

  const rails = document.querySelectorAll<HTMLElement>('.nav-rail');
  const panels = document.querySelectorAll<HTMLElement>('.nav-panel');
  const showPanel = (idx: string) => {
    rails.forEach((r) => r.setAttribute('aria-current', String(r.dataset.cat === idx)));
    panels.forEach((p) => { p.hidden = p.dataset.panel !== idx; });
  };
  rails.forEach((r) => {
    r.addEventListener('mouseenter', () => showPanel(r.dataset.cat!));
    r.addEventListener('focus', () => showPanel(r.dataset.cat!));
  });
  if (rails[0]) rails[0].setAttribute('aria-current', 'true');

  // Tool links live in a JSON blob, not the HTML — build the grids on first open.
  let megaBuilt = false;
  const buildMega = () => {
    if (megaBuilt) return;
    megaBuilt = true;
    const raw = document.getElementById('mega-data')?.textContent;
    if (!raw) return;
    const NS = 'http://www.w3.org/2000/svg';
    const data = JSON.parse(raw) as { fg: string; tools: [string, string, string][] }[];
    const grids = document.querySelectorAll<HTMLElement>('.nav-grid');
    data.forEach((cat, i) => {
      const grid = grids[i];
      if (!grid) return;
      const frag = document.createDocumentFragment();
      for (const [slug, name, icon] of cat.tools) {
        const a = document.createElement('a');
        a.href = `/${slug}`;
        a.className = 'flex items-center gap-2 truncate rounded-md px-2 py-1.5 text-[13px] text-ink-subtle hover:bg-surface-3 hover:text-ink';
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('width', '15');
        svg.setAttribute('height', '15');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
        svg.setAttribute('stroke-width', '1.75');
        svg.setAttribute('stroke-linecap', 'round');
        svg.setAttribute('stroke-linejoin', 'round');
        svg.setAttribute('class', `flex-none ${cat.fg}`);
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', icon);
        svg.appendChild(path);
        const span = document.createElement('span');
        span.className = 'truncate';
        span.textContent = name;
        a.append(svg, span);
        frag.appendChild(a);
      }
      grid.appendChild(frag);
    });
  };

  // --- Mobile tool browser --------------------------------------------------
  // Same #mega-data blob as the desktop mega-menu, laid out as flowing columns of category
  // sections. Built once, on first open, so pages that never open it pay nothing.
  const mtBtn = document.getElementById('mtools-open');
  const mtPanel = document.getElementById('mtools-panel');
  const mtBody = document.getElementById('mtools-body');
  if (mtBtn && mtPanel && mtBody) {
    const NS2 = 'http://www.w3.org/2000/svg';
    let mtBuilt = false;

    const buildMobile = () => {
      if (mtBuilt) return;
      mtBuilt = true;
      const raw = document.getElementById('mega-data')?.textContent;
      if (!raw) return;
      const data = JSON.parse(raw) as {
        name: string; slug: string; emoji: string; fg: string; tools: [string, string, string][];
      }[];
      const sections: HTMLElement[] = [];
      for (const cat of data) {
        const section = document.createElement('section');
        section.className = 'mb-4';

        const h = document.createElement('a');
        h.href = `/tools/${cat.slug}`;
        h.className = 'mb-2 flex items-center gap-1.5 text-[16px] font-semibold uppercase tracking-wide text-ink no-underline';
        const em = document.createElement('img');
        em.src = cat.emoji; em.width = 17; em.height = 17; em.alt = ''; em.loading = 'lazy';
        em.setAttribute('aria-hidden', 'true');
        em.className = 'flex-none';
        const hl = document.createElement('span');
        hl.textContent = cat.name;
        h.appendChild(em);
        h.appendChild(hl);
        section.appendChild(h);

        for (const [slug, name, icon] of cat.tools) {
          const a = document.createElement('a');
          a.href = `/${slug}`;
          a.className = 'flex items-center gap-2 rounded-md py-1.5 text-[14px] leading-snug text-ink-subtle no-underline hover:text-ink';
          const svg = document.createElementNS(NS2, 'svg');
          svg.setAttribute('width', '14');
          svg.setAttribute('height', '14');
          svg.setAttribute('viewBox', '0 0 24 24');
          svg.setAttribute('fill', 'none');
          svg.setAttribute('stroke', 'currentColor');
          svg.setAttribute('stroke-width', '1.75');
          svg.setAttribute('stroke-linecap', 'round');
          svg.setAttribute('stroke-linejoin', 'round');
          svg.setAttribute('class', `flex-none ${cat.fg}`);
          const p = document.createElementNS(NS2, 'path');
          p.setAttribute('d', icon);
          svg.appendChild(p);
          const sp = document.createElement('span');
          sp.className = 'min-w-0 flex-1';
          sp.textContent = name;
          a.appendChild(svg);
          a.appendChild(sp);
          section.appendChild(a);
        }
        sections.push(section);
      }

      // ponytail: pack whole sections into flex columns rather than using CSS multi-column.
      // CSS columns split a tall category mid-list and the continuation loses its heading — there's
      // no way to repeat one. Packing by section means nothing splits, so nothing is orphaned.
      const wrap = document.createElement('div');
      wrap.className = 'flex items-start gap-5';
      const n = Math.min(4, Math.max(1, Math.floor((mtBody.clientWidth || 320) / 152)));
      const cols: HTMLElement[] = [];
      for (let i = 0; i < n; i++) {
        const c = document.createElement('div');
        c.className = 'min-w-0 flex-1';
        cols.push(c);
        wrap.appendChild(c);
      }
      mtBody.appendChild(wrap);
      // Each section lands in whichever column is currently shortest, measured live after every
      // append. Deciding the split up front from tool counts or pre-measured heights kept ending up
      // lopsided; reading the real height as we go can't be wrong, and an empty column is always
      // the shortest, so none can be left blank.
      for (const s of sections) {
        let best = 0;
        for (let i = 1; i < n; i++) {
          if (cols[i].offsetHeight < cols[best].offsetHeight) best = i;
        }
        cols[best].appendChild(s);
      }
    };

    const setOpen = (open: boolean) => {
      // Unhide first: the column count reads mtBody.clientWidth, which is 0 while display:none.
      mtPanel.classList.toggle('hidden', !open);
      if (open) buildMobile();
      mtBtn.setAttribute('aria-expanded', String(open));
      // Stop the page behind from scrolling while the sheet is up.
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) mtBody.scrollTop = 0;
    };

    mtBtn.addEventListener('click', () => setOpen(mtPanel.classList.contains('hidden')));
    document.getElementById('mtools-close')?.addEventListener('click', () => setOpen(false));
    document.getElementById('mtools-backdrop')?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mtPanel.classList.contains('hidden')) setOpen(false);
    });
    // Tapping a tool navigates; clear the scroll lock so a restored back-forward page isn't frozen.
    mtBody.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }

  const navTools = document.querySelector<HTMLElement>('.nav-tools');
  const mega = document.querySelector<HTMLElement>('.nav-mega');
  const megaCard = document.querySelector<HTMLElement>('.nav-mega-card');
  if (navTools && mega && megaCard) {
    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    const open = () => { buildMega(); if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; } mega.classList.add('open'); };
    const scheduleClose = () => { if (closeTimer) clearTimeout(closeTimer); closeTimer = setTimeout(() => mega.classList.remove('open'), 220); };
    [navTools, megaCard].forEach((el) => {
      el.addEventListener('mouseenter', open);
      el.addEventListener('mouseleave', scheduleClose);
    });
    navTools.addEventListener('focusin', open);
    navTools.addEventListener('focusout', scheduleClose);
  }

  const root = document.documentElement;
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  const applyMeta = (theme: string) =>
    themeMeta?.setAttribute('content', theme === 'light' ? '#ffffff' : '#010102');

  applyMeta(root.dataset.theme || 'dark');

  const setTheme = (theme: string) => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch (_) {}
    applyMeta(theme);
  };

  document.querySelectorAll('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      setTheme(root.dataset.theme === 'light' ? 'dark' : 'light');
    });
  });
</script>
