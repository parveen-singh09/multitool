---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-page-numbers">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <div class="flex flex-wrap items-end gap-4">
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Position
          <select id="pos" class="field w-40">
            <option value="bc">Bottom center</option>
            <option value="br">Bottom right</option>
            <option value="bl">Bottom left</option>
            <option value="tc">Top center</option>
            <option value="tr">Top right</option>
            <option value="tl">Top left</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Format
          <select id="fmt" class="field w-44">
            <option value="n">1</option>
            <option value="pn">Page 1</option>
            <option value="nof">1 of N</option>
            <option value="pnof">Page 1 of N</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Start at
          <input id="start" type="number" value="1" min="0" class="field w-24" />
        </label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Font size
          <input id="size" type="number" value="11" min="6" max="48" class="field w-24" />
        </label>
        <button id="go" class="btn btn-primary">Download</button>
      </div>
      <div id="viewer-mount"></div>
    </div>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool stamps page numbers onto a PDF. Pick a corner or center position, a starting number and a format like "Page 1 of 10", then download. The numbering is drawn directly onto each page — no watermark from us.</p>
  </div>
</ToolLayout>

<style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }</style>

<script>
  import { PDFDocument, StandardFonts, rgb } from 'pdf-lib';
  import { setupDrop, download } from '../lib/pdfui';
  import { mountViewer } from '../lib/pdfViewer';

  const $ = (id: string) => document.getElementById(id)!;
  const panel = $('panel'), err = $('error'), status = $('status'), mount = $('viewer-mount');
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf';
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      await PDFDocument.load(bytes.slice(0)); // validate
      panel.classList.remove('hidden'); panel.classList.add('flex');
    } catch (e) {
      console.error('[pdf-page-numbers] load failed:', e);
      setErr('Could not open that PDF: ' + (e as Error).message);
    }
  }

  function label(fmt: string, n: number, total: number): string {
    if (fmt === 'pn') return `Page ${n}`;
    if (fmt === 'nof') return `${n} of ${total}`;
    if (fmt === 'pnof') return `Page ${n} of ${total}`;
    return String(n);
  }

  // Build the numbered PDF bytes. Shared by the live preview and the download.
  async function build(): Promise<{ bytes: Uint8Array; n: number } | null> {
    if (!bytes) return null;
    const doc = await PDFDocument.load(bytes.slice(0));
    const font = await doc.embedFont(StandardFonts.Helvetica);
    const pages = doc.getPages();
    const total = pages.length;
    const start = parseInt(($('start') as HTMLInputElement).value, 10) || 0;
    const size = Math.min(48, Math.max(6, +($('size') as HTMLInputElement).value || 11));
    const pos = ($('pos') as HTMLSelectElement).value;
    const fmt = ($('fmt') as HTMLSelectElement).value;
    const M = 24;
    pages.forEach((page, i) => {
      const { width, height } = page.getSize();
      const text = label(fmt, start + i, start + total - 1);
      const tw = font.widthOfTextAtSize(text, size);
      const x = pos[1] === 'l' ? M : pos[1] === 'r' ? width - tw - M : (width - tw) / 2;
      const y = pos[0] === 't' ? height - M - size : M;
      page.drawText(text, { x, y, size, font, color: rgb(0.1, 0.1, 0.1) });
    });
    return { bytes: await doc.save(), n: total };
  }

  async function run() {
    if (!bytes) return;
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Working…';
    try {
      const out = await build();
      if (!out) return;
      download(out.bytes, `${fname}-numbered.pdf`);
      status.textContent = `Done — numbered ${out.n} page(s).`;
    } catch (e) { status.classList.add('hidden'); setErr('Could not add numbers: ' + (e as Error).message); }
  }

  // Debounced full-document preview: stamp numbers, then mount the viewer on the numbered output.
  let seq = 0, timer: ReturnType<typeof setTimeout> | null = null;
  async function renderPreview() {
    if (!bytes) return;
    const my = ++seq;
    try {
      const out = await build();
      if (!out || my !== seq) return;
      const prev = viewer;
      viewer = await mountViewer({ file: new File([out.bytes as BlobPart], 'numbered.pdf', { type: 'application/pdf' }) });
      if (my !== seq) { viewer.destroy(); return; } // a newer render superseded us
      prev?.destroy();
      mount.replaceChildren(viewer.root);
    } catch (e) { console.error('[pdf-page-numbers] preview failed:', e); }
  }
  const schedule = () => { if (timer) clearTimeout(timer); timer = setTimeout(renderPreview, 400); };

  setupDrop($('dz'), $('file') as HTMLInputElement, async (f) => { await load(f); renderPreview(); });
  panel.addEventListener('input', schedule);
  panel.addEventListener('change', schedule);
  $('go').addEventListener('click', run);
</script>
