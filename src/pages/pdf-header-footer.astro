---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-header-footer">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <p class="text-[13px] text-ink-subtle"><span id="name"></span> — <span id="pages">0</span> pages</p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Header left<input id="hl" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Header center<input id="hc" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Header right<input id="hr" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Footer left<input id="fl" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Footer center<input id="fc" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Footer right<input id="fr" type="text" class="field" /></label>
      </div>
      <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Font size
        <input id="size" type="number" value="10" min="6" max="24" class="field w-24" />
      </label>
      <button id="go" class="btn btn-primary w-fit self-end">Download</button>
      <div id="viewer-mount"></div>
    </div>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool adds running headers and footers to a PDF. Fill in left, center or right slots for the top and bottom margins, then download. The text is drawn onto every page.</p>
  </div>
</ToolLayout>

<style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; } code { background: var(--color-surface-2); color: var(--color-ink); padding: 0 4px; border-radius: 3px; }</style>

<script>
  import { PDFDocument, StandardFonts, rgb, type PDFFont } from 'pdf-lib';
  import { setupDrop, download, bindRun } from '../lib/pdfui';
  import { mountViewer } from '../lib/pdfViewer';
  import { stampCorner, pageGeom, placeStamp, type PageGeom, type Corner } from '../lib/pdfStamp';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const panel = document.getElementById('panel')!, err = document.getElementById('error')!, status = document.getElementById('status')!;
  const mount = document.getElementById('viewer-mount')!;
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf';
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  let geoms: PageGeom[] = [];          // per-page visible box + rotation, read once at load
  let measure: PDFFont | null = null;  // Helvetica metrics for preview text widths
  const rows: HTMLElement[][] = [];    // per page: one preview span per slot, in SLOTS order
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  // Input id -> the corner it stamps. The ids already encode header/footer + left/center/right.
  const SLOTS: { id: string; corner: Corner }[] = [
    { id: 'hl', corner: 'tl' }, { id: 'hc', corner: 'tc' }, { id: 'hr', corner: 'tr' },
    { id: 'fl', corner: 'bl' }, { id: 'fc', corner: 'bc' }, { id: 'fr', corner: 'br' },
  ];
  const values = () => SLOTS.map((s) => $(s.id).value);
  const fontSize = () => Math.min(24, Math.max(6, +$('size').value || 10));
  const sub = (t: string, n: number, total: number) => t.replace(/\{n\}/g, String(n)).replace(/\{total\}/g, String(total));

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      const doc = await PDFDocument.load(bytes.slice(0));
      geoms = doc.getPages().map(pageGeom);
      measure = await doc.embedFont(StandardFonts.Helvetica);
      document.getElementById('name')!.textContent = files[0].name;
      document.getElementById('pages')!.textContent = String(doc.getPageCount());
      panel.classList.remove('hidden'); panel.classList.add('flex');

      // Mount once on the original file; the six slots preview as DOM overlays. The old code
      // re-stamped and remounted the entire document on every keystroke.
      const prev = viewer;
      rows.length = 0;
      viewer = await mountViewer({
        file: files[0],
        mount,
        onPage: (page, slot) => {
          slot.style.setProperty('container-type', 'inline-size'); // placeStamp sizes in cqw
          rows[page - 1] = SLOTS.map(() => {
            const s = document.createElement('span');
            s.className = 'pointer-events-none z-10';
            s.style.fontFamily = 'Helvetica, Arial, sans-serif';
            s.style.color = '#1a1a1a';
            slot.appendChild(s);
            return s;
          });
        },
      });
      prev?.destroy();
      mount.replaceChildren(viewer.root);
      paint();
    } catch (e) {
      console.error('[pdf-header-footer] load failed:', e);
      setErr('Could not open that PDF: ' + (e as Error).message);
    }
  }

  // Preview: retext and reposition the overlays. Pure DOM, no PDF rebuild.
  function paint() {
    const vals = values(), size = fontSize(), total = geoms.length;
    if (!measure) return;
    rows.forEach((spans, i) => {
      if (!geoms[i]) return;
      SLOTS.forEach((slot, k) => {
        const span = spans?.[k];
        if (!span) return;
        const text = sub(vals[k], i + 1, total);
        // Empty slots collapse rather than positioning an invisible span.
        if (!text.trim()) { span.textContent = ''; span.style.display = 'none'; return; }
        span.style.display = '';
        placeStamp(span, geoms[i], { text, corner: slot.corner, size, textWidth: measure!.widthOfTextAtSize(text, size) });
      });
    });
  }

  async function run() {
    if (!bytes) return;
    const vals = values();
    if (vals.every((s) => !s.trim())) { setErr('Enter text in at least one slot.'); return; }
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Working…';
    const go = document.getElementById('go') as HTMLButtonElement;
    go.disabled = true;
    try {
      const size = fontSize();
      const doc = await PDFDocument.load(bytes.slice(0));
      const font = await doc.embedFont(StandardFonts.Helvetica);
      const pages = doc.getPages();
      const total = pages.length;
      // stampCorner anchors to the CropBox and compensates for /Rotate. The old footer baseline
      // (M - size + 4) sat below even the MediaBox floor, so footers could vanish entirely.
      pages.forEach((page, i) => SLOTS.forEach((slot, k) => {
        const text = sub(vals[k], i + 1, total);
        if (text.trim()) stampCorner(page, { text, font, size, corner: slot.corner, color: rgb(0.1, 0.1, 0.1) });
      }));
      download(await doc.save(), `${fname}-header-footer.pdf`);
      status.textContent = `Done — stamped ${total} page(s).`;
    } catch (e) {
      status.classList.add('hidden'); setErr('Could not stamp: ' + (e as Error).message);
    } finally { go.disabled = false; }
  }

  setupDrop(document.getElementById('dz')!, $('file'), load);
  panel.addEventListener('input', paint);
  panel.addEventListener('change', paint);
  bindRun(document.getElementById('go')!, run);
</script>
