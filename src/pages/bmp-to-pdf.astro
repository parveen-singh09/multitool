---
import ToolLayout from '../layouts/ToolLayout.astro';
import RasterBatch from '../components/RasterBatch.astro';
---

<ToolLayout slug="bmp-to-pdf">
  <RasterBatch to="pdf" accept="image/bmp,.bmp" fromLabel="BMP" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free BMP to PDF converter combines your BMP bitmaps into a single PDF document, sizing each page to its image.    </p>
    <p>
      Drop a single image or a whole batch at once, optionally resize by the longest side,
      and preview each result before you download. Conversions run through the browser's canvas.
    </p>
  </div>
</ToolLayout>
