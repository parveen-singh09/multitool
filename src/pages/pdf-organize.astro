---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-organize">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[13px] text-ink-subtle"><span id="name"></span> — <span id="left">0</span> of <span id="total">0</span> pages kept</span>
        <span class="flex-1"></span>
        <button id="rot-all" class="btn btn-secondary px-3 py-1.5 text-[13px]" type="button">Rotate all</button>
        <button id="reset" class="btn btn-secondary px-3 py-1.5 text-[13px]" type="button">Reset</button>
        <button id="go" class="btn btn-primary px-3 py-1.5 text-[13px]" type="button">Download</button>
      </div>
      <p class="text-xs text-ink-tertiary">Drag a page to reorder (works on touch too). Use the buttons on each page to rotate or delete it.</p>
      <ul id="grid" class="grid grid-cols-2 gap-4 rounded-lg border border-hairline bg-[#1a1a1d] p-4 sm:grid-cols-3 md:grid-cols-4"></ul>
    </div>
    <p id="loading" class="hidden text-[13px] text-ink-subtle">Rendering pages…</p>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool lets you organize a PDF visually. Every page appears as a thumbnail — drag them into a new order, rotate any page in 90° steps, and delete the ones you do not need. When you are happy, download the rearranged document.</p>
  </div>
</ToolLayout>

<style>
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
  /* touch-action:none lets pointer-drag work on touch without the browser
     stealing the gesture for scrolling. Scroll the page from the gaps/margins. */
  .pg-card { position: relative; cursor: grab; touch-action: none; }
  .pg-card.dragging { opacity: 0.35; }
  .pg-card.over { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .pg-ghost { position: fixed; z-index: 60; pointer-events: none; opacity: 0.85;
    transform: translate(-50%, -50%); box-shadow: 0 8px 24px rgba(0,0,0,0.5); }
  .pg-thumb { transition: transform 0.2s ease; }
  /* Always visible (not hover-gated) so delete/rotate work on touch devices too. */
  .pg-tools { position: absolute; top: 6px; right: 6px; display: flex; gap: 4px; z-index: 2; }
  /* Solid, high-contrast so the tools stay visible on white page thumbnails. */
  .pg-btn { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.28); background: rgba(20,20,24,0.92); color: #fff; cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,0.45); }
  .pg-btn:hover { background: rgba(20,20,24,1); }
  .pg-btn[data-act="del"]:hover { color: #ff6169; border-color: #ff6169; }
  .pg-num { position: absolute; bottom: 6px; left: 6px; font-size: 11px; padding: 1px 6px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-surface-1) 88%, transparent); color: var(--color-ink-subtle); }
</style>

<script>
  import { PDFDocument, degrees } from 'pdf-lib';
  import { setupDrop, download, bindRun } from '../lib/pdfui';
  import { renderThumbs } from '../lib/pdfThumbs';

  interface Item { id: number; src: number; rot: number; url: string }
  let nextId = 0;

  const $ = (id: string) => document.getElementById(id)!;
  const panel = $('panel'), grid = $('grid') as HTMLUListElement;
  const err = $('error'), status = $('status'), loading = $('loading');
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf';
  let items: Item[] = [];
  let original: Item[] = [];
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      // Keep a pristine copy for export; renderThumbs works on its own slice.
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      items = []; grid.innerHTML = '';
      $('name').textContent = files[0].name;
      panel.classList.remove('hidden'); panel.classList.add('flex');
      loading.classList.remove('hidden');
      const { total, truncated } = await renderThumbs(files[0], {
        onThumb: (t) => { items.push({ id: nextId++, src: t.page - 1, rot: 0, url: t.url }); render(); },
      });
      loading.classList.add('hidden');
      original = items.map((it) => ({ ...it }));
      $('total').textContent = String(total);
      if (truncated) setErr(`Showing the first ${items.length} of ${total} pages (large-file limit).`);
    } catch { loading.classList.add('hidden'); setErr('Could not read that PDF. Encrypted files are not supported.'); }
  }

  function render() {
    $('left').textContent = String(items.length);
    grid.innerHTML = '';
    items.forEach((it, i) => {
      const li = document.createElement('li');
      li.className = 'pg-card overflow-hidden rounded bg-white shadow-lg';
      li.dataset.idx = String(i);
      li.dataset.id = String(it.id);
      li.innerHTML = `
        <img src="${it.url}" class="pg-thumb w-full rounded" style="transform:rotate(${it.rot}deg)" alt="Page ${it.src + 1}" draggable="false" />
        <span class="pg-num">${i + 1}</span>
        <div class="pg-tools">
          <button type="button" class="pg-btn" data-act="rot" aria-label="Rotate page" title="Rotate">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8"/></svg>
          </button>
          <button type="button" class="pg-btn" data-act="del" aria-label="Delete page" title="Delete">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
          </button>
        </div>`;
      li.addEventListener('pointerdown', (e) => onDragStart(e as PointerEvent, i, li));
      grid.appendChild(li);
    });
  }

  // Pointer-based reordering — works on both mouse and touch (HTML5 drag-and-drop
  // does not fire on touchscreens at all, which is why mobile drag was dead).
  // We reorder `items` live as the pointer moves and re-render, so the grid
  // reflows under the cursor and you see the real landing layout while dragging.
  let ptr: null | { id: number; startX: number; startY: number; ghost: HTMLElement | null; active: boolean } = null;

  const cardById = (id: number) => grid.querySelector<HTMLElement>(`.pg-card[data-id="${id}"]`);
  const idxById = (id: number) => items.findIndex((it) => it.id === id);

  function cardUnder(x: number, y: number): HTMLElement | null {
    // Ghost is pointer-events:none, so elementFromPoint sees the card beneath it.
    const el = document.elementFromPoint(x, y) as HTMLElement | null;
    const card = el?.closest<HTMLElement>('.pg-card') ?? null;
    return card && card.parentElement === grid ? card : null;
  }

  function onDragStart(e: PointerEvent, i: number, card: HTMLElement) {
    // A press that starts on a tool button is a click, never a drag.
    if ((e.target as HTMLElement).closest('.pg-btn')) return;
    if (e.button && e.button !== 0) return;
    ptr = { id: items[i].id, startX: e.clientX, startY: e.clientY, ghost: null, active: false };
    window.addEventListener('pointermove', onDragMove);
    window.addEventListener('pointerup', onDragEnd, { once: true });
    window.addEventListener('pointercancel', onDragEnd, { once: true });
  }

  function onDragMove(e: PointerEvent) {
    if (!ptr) return;
    const card = cardById(ptr.id);
    if (!card) return;
    if (!ptr.active) {
      // Small threshold so a tap or tiny jitter doesn't become a drag.
      if (Math.hypot(e.clientX - ptr.startX, e.clientY - ptr.startY) < 6) return;
      ptr.active = true;
      document.body.style.userSelect = 'none';
      const g = card.cloneNode(true) as HTMLElement;
      g.className = 'pg-card pg-ghost overflow-hidden rounded bg-white shadow-lg';
      g.style.width = `${card.offsetWidth}px`;
      document.body.appendChild(g);
      ptr.ghost = g;
    }
    if (ptr.ghost) { ptr.ghost.style.left = `${e.clientX}px`; ptr.ghost.style.top = `${e.clientY}px`; }
    card.classList.add('dragging');
    // Reflow live: if hovering a different card, move the dragged item to its
    // slot and re-render so the pages physically shift to show the new order.
    const over = cardUnder(e.clientX, e.clientY);
    if (over && over.dataset.id !== String(ptr.id)) {
      const from = idxById(ptr.id);
      const to = idxById(Number(over.dataset.id));
      if (from >= 0 && to >= 0 && from !== to) {
        const [m] = items.splice(from, 1);
        items.splice(to, 0, m);
        render();
        cardById(ptr.id)?.classList.add('dragging');
      }
    }
  }

  function onDragEnd() {
    window.removeEventListener('pointermove', onDragMove);
    if (!ptr) return;
    ptr.ghost?.remove();
    document.body.style.userSelect = '';
    const active = ptr.active;
    ptr = null;
    if (active) render(); // clears the dragging class and renumbers; order is already applied live
  }

  async function run() {
    if (!bytes || !items.length) { setErr('Keep at least one page.'); return; }
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Building…';
    try {
      const src = await PDFDocument.load(bytes);
      const out = await PDFDocument.create();
      const copied = await out.copyPages(src, items.map((it) => it.src));
      copied.forEach((p, i) => {
        const extra = items[i].rot;
        if (extra) p.setRotation(degrees((p.getRotation().angle + extra) % 360));
        out.addPage(p);
      });
      download(await out.save(), `${fname}-organized.pdf`);
      status.textContent = `Done — ${out.getPageCount()} page(s).`;
    } catch (e) { status.classList.add('hidden'); setErr('Could not build: ' + (e as Error).message); }
  }

  // One delegated handler on the grid — a click on a tool button can't be
  // swallowed by the draggable card the way per-button listeners could be.
  grid.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pg-btn');
    if (!btn) return;
    e.stopPropagation(); e.preventDefault();
    const card = btn.closest<HTMLElement>('.pg-card');
    const i = Number(card?.dataset.idx);
    if (!Number.isInteger(i) || i < 0 || i >= items.length) return;
    if (btn.dataset.act === 'del') items.splice(i, 1);
    else if (btn.dataset.act === 'rot') items[i].rot = (items[i].rot + 90) % 360;
    render();
  });

  setupDrop($('dz'), $('file') as HTMLInputElement, load);
  $('rot-all').addEventListener('click', () => { items.forEach((it) => (it.rot = (it.rot + 90) % 360)); render(); });
  $('reset').addEventListener('click', () => { items = original.map((it) => ({ ...it })); render(); });
  bindRun($('go'), run);
</script>
