---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-organize">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[13px] text-ink-subtle"><span id="name"></span> — <span id="left">0</span> of <span id="total">0</span> pages kept</span>
        <span class="flex-1"></span>
        <button id="rot-all" class="btn btn-secondary px-3 py-1.5 text-[13px]" type="button">Rotate all</button>
        <button id="reset" class="btn btn-secondary px-3 py-1.5 text-[13px]" type="button">Reset</button>
        <button id="go" class="btn btn-primary px-3 py-1.5 text-[13px]" type="button">Download</button>
      </div>
      <p class="text-xs text-ink-tertiary">Drag a page to reorder. Hover a page to rotate or delete it.</p>
      <ul id="grid" class="grid grid-cols-2 gap-4 rounded-lg border border-hairline bg-[#1a1a1d] p-4 sm:grid-cols-3 md:grid-cols-4"></ul>
    </div>
    <p id="loading" class="hidden text-[13px] text-ink-subtle">Rendering pages…</p>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool lets you organize a PDF visually. Every page appears as a thumbnail — drag them into a new order, rotate any page in 90° steps, and delete the ones you do not need. When you are happy, download the rearranged document.</p>
  </div>
</ToolLayout>

<style>
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
  .pg-card { position: relative; cursor: grab; }
  .pg-card.dragging { opacity: 0.4; }
  .pg-card.over { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .pg-thumb { transition: transform 0.2s ease; }
  .pg-tools { position: absolute; top: 6px; right: 6px; display: none; gap: 4px; }
  .pg-card:hover .pg-tools { display: flex; }
  .pg-btn { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: var(--radius-sm); border: none; background: color-mix(in srgb, var(--color-surface-1) 88%, transparent); backdrop-filter: blur(4px); color: var(--color-ink-subtle); cursor: pointer; }
  .pg-btn:hover { color: var(--color-ink); }
  .pg-num { position: absolute; bottom: 6px; left: 6px; font-size: 11px; padding: 1px 6px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-surface-1) 88%, transparent); color: var(--color-ink-subtle); }
</style>

<script>
  import { PDFDocument, degrees } from 'pdf-lib';
  import { setupDrop, download } from '../lib/pdfui';
  import { renderThumbs } from '../lib/pdfThumbs';

  interface Item { src: number; rot: number; url: string }

  const $ = (id: string) => document.getElementById(id)!;
  const panel = $('panel'), grid = $('grid') as HTMLUListElement;
  const err = $('error'), status = $('status'), loading = $('loading');
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf';
  let items: Item[] = [];
  let original: Item[] = [];
  let dragIdx = -1;
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      // Keep a pristine copy for export; renderThumbs works on its own slice.
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      items = []; grid.innerHTML = '';
      $('name').textContent = files[0].name;
      panel.classList.remove('hidden'); panel.classList.add('flex');
      loading.classList.remove('hidden');
      const { total, truncated } = await renderThumbs(files[0], {
        onThumb: (t) => { items.push({ src: t.page - 1, rot: 0, url: t.url }); render(); },
      });
      loading.classList.add('hidden');
      original = items.map((it) => ({ ...it }));
      $('total').textContent = String(total);
      if (truncated) setErr(`Showing the first ${items.length} of ${total} pages (large-file limit).`);
    } catch { loading.classList.add('hidden'); setErr('Could not read that PDF. Encrypted files are not supported.'); }
  }

  function render() {
    $('left').textContent = String(items.length);
    grid.innerHTML = '';
    items.forEach((it, i) => {
      const li = document.createElement('li');
      li.className = 'pg-card overflow-hidden rounded bg-white shadow-lg'; li.draggable = true;
      li.innerHTML = `
        <img src="${it.url}" class="pg-thumb w-full rounded" style="transform:rotate(${it.rot}deg)" alt="Page ${it.src + 1}" />
        <span class="pg-num">${i + 1}</span>
        <div class="pg-tools">
          <button type="button" class="pg-btn" data-act="rot" aria-label="Rotate page">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8"/></svg>
          </button>
          <button type="button" class="pg-btn" data-act="del" aria-label="Delete page">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
          </button>
        </div>`;
      li.querySelector('[data-act="rot"]')!.addEventListener('click', (e) => { e.stopPropagation(); it.rot = (it.rot + 90) % 360; render(); });
      li.querySelector('[data-act="del"]')!.addEventListener('click', (e) => { e.stopPropagation(); items.splice(i, 1); render(); });
      li.addEventListener('dragstart', () => { dragIdx = i; li.classList.add('dragging'); });
      li.addEventListener('dragend', () => { dragIdx = -1; li.classList.remove('dragging'); });
      li.addEventListener('dragover', (e) => { e.preventDefault(); li.classList.add('over'); });
      li.addEventListener('dragleave', () => li.classList.remove('over'));
      li.addEventListener('drop', (e) => {
        e.preventDefault(); li.classList.remove('over');
        if (dragIdx < 0 || dragIdx === i) return;
        const [m] = items.splice(dragIdx, 1); items.splice(i, 0, m); dragIdx = -1; render();
      });
      grid.appendChild(li);
    });
  }

  async function run() {
    if (!bytes || !items.length) { setErr('Keep at least one page.'); return; }
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Building…';
    try {
      const src = await PDFDocument.load(bytes);
      const out = await PDFDocument.create();
      const copied = await out.copyPages(src, items.map((it) => it.src));
      copied.forEach((p, i) => {
        const extra = items[i].rot;
        if (extra) p.setRotation(degrees((p.getRotation().angle + extra) % 360));
        out.addPage(p);
      });
      download(await out.save(), `${fname}-organized.pdf`);
      status.textContent = `Done — ${out.getPageCount()} page(s).`;
    } catch (e) { status.classList.add('hidden'); setErr('Could not build: ' + (e as Error).message); }
  }

  setupDrop($('dz'), $('file') as HTMLInputElement, load);
  $('rot-all').addEventListener('click', () => { items.forEach((it) => (it.rot = (it.rot + 90) % 360)); render(); });
  $('reset').addEventListener('click', () => { items = original.map((it) => ({ ...it })); render(); });
  $('go').addEventListener('click', run);
</script>
