---
import ToolLayout from '../layouts/ToolLayout.astro';
import DocConvert from '../components/DocConvert.astro';
---

<ToolLayout slug="word-to-pdf">
  <DocConvert slug="word-to-pdf" outLabel="PDF" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free Word to PDF converter converts a Word (.docx) document into a PDF document. It extracts the document text — original layout, images and fonts are not reproduced.    </p>
    <p>
      Paste your content or attach a file, click Convert, then download or copy the result.
    </p>
  </div>
</ToolLayout>
