---
import ToolLayout from '../layouts/ToolLayout.astro';
import DocConvert from '../components/DocConvert.astro';
---

<ToolLayout slug="ppt-to-html">
  <DocConvert slug="ppt-to-html" outLabel="HTML" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free PowerPoint to HTML converter converts a PowerPoint (.pptx) presentation into an HTML document. It extracts the slide text — visual layout is not reproduced.    </p>
    <p>
      Paste your content or attach a file, click Convert, then download or copy the result.
    </p>
  </div>
</ToolLayout>
