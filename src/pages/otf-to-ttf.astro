---
import ToolLayout from '../layouts/ToolLayout.astro';
import FontConvert from '../components/FontConvert.astro';
---

<ToolLayout slug="otf-to-ttf">
  <FontConvert slug="otf-to-ttf" from="otf" to="ttf" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free OTF to TTF converter converts OpenType OTF fonts to TrueType TTF for wider software compatibility.
    </p>
    <p>
      Convert one font or a whole batch and download the results individually or
      as a ZIP. Each converted font shows an editable live preview so you can
      confirm it renders before you download. Everything runs in your browser —
      your fonts are never uploaded.
    </p>
  </div>
</ToolLayout>
