---
import ToolLayout from '../layouts/ToolLayout.astro';
import RasterBatch from '../components/RasterBatch.astro';
---

<ToolLayout slug="jfif-to-psd">
  <RasterBatch to="psd" accept="image/jpeg,.jfif,.jpg,.jpeg" fromLabel="JFIF" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free JFIF to PSD converter writes each .jfif image as an uncompressed Adobe Photoshop (.psd) file that opens in Photoshop, Photopea and GIMP.
    </p>
    <p>
      Drop a single image or a whole batch at once, optionally resize by the longest side,
      and preview each result before you download.
    </p>
  </div>
</ToolLayout>
