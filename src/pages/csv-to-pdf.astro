---
import ToolLayout from '../layouts/ToolLayout.astro';
import DocConvert from '../components/DocConvert.astro';
---

<ToolLayout slug="csv-to-pdf">
  <DocConvert slug="csv-to-pdf" outLabel="PDF" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free CSV to PDF converter converts CSV data into a PDF document.    </p>
    <p>
      Paste your content or attach a file, click Convert, then download or copy the result.    </p>
  </div>
</ToolLayout>
