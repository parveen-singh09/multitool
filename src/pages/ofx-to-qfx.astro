---
import ToolLayout from '../layouts/ToolLayout.astro';
import DocConvert from '../components/DocConvert.astro';
---

<ToolLayout slug="ofx-to-qfx">
  <DocConvert slug="ofx-to-qfx" outLabel="QFX" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free OFX to QFX converter converts an OFX/QFX bank export into a Quicken QFX file.
    </p>
    <p>
      Paste your content or attach a file, click Convert, then download or copy the result.
    </p>
  </div>
</ToolLayout>
