---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-split">
  <div class="flex flex-col gap-4">
    <label id="ps-drop" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose PDFs or drop them here</span>
      <input id="ps-file" type="file" accept="application/pdf" multiple class="sr-only" />
    </label>

    <div id="ps-panel" class="hidden flex-col gap-4">
      <p class="text-[13px] text-ink-subtle"><span id="ps-name"></span> · <span id="ps-pages">0</span> pages</p>

      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Split mode">
        <button data-mode="range" class="ps-tab btn btn-primary" aria-selected="true">Extract range</button>
        <button data-mode="each" class="ps-tab btn btn-secondary" aria-selected="false">Every page separately</button>
      </div>

      <div id="ps-range-wrap" class="flex flex-col gap-2">
        <label class="flex flex-col gap-1 text-sm text-ink-subtle">
          <span class="whitespace-nowrap">Pages to extract (e.g. <span class="font-mono">1-3, 5, 8-10</span>)</span>
          <input id="ps-range" class="field font-mono" placeholder="1-3, 5" spellcheck="false" autocomplete="off" />
        </label>
      </div>

      <button id="ps-go" class="btn btn-primary w-fit">Download</button>
    </div>
    <p id="ps-loading" class="hidden text-[13px] text-ink-subtle">Rendering pages…</p>
    <p id="ps-error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="ps-status" class="hidden text-[13px] text-ink-subtle"></p>

    <div id="ps-preview-wrap" class="hidden flex-col gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[13px] text-ink-subtle">Pages — hover a page to delete it. Extraction counts what you keep.</span>
        <span class="flex-1"></span>
        <button id="ps-reset" class="btn btn-secondary px-3 py-1.5 text-[13px]" type="button">Restore deleted</button>
      </div>
      <div id="ps-viewer"></div>
    </div>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free PDF split tool extracts pages from a PDF. Load a single file to see
      every page as a thumbnail — delete any you do not want, then extract a range
      like <code>1-3, 5, 8-10</code> into a new PDF or split every remaining page into
      its own file. Ranges count the pages you keep, so what you see is what you get.
      Load several PDFs at once to split them in bulk into a ZIP. The original stays
      untouched.
    </p>
  </div>
</ToolLayout>

<style>
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
</style>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { makeZip } from '../lib/zip';
  import { mountViewer } from '../lib/pdfViewer';
  import { bindRun } from '../lib/pdfui';

  const $ = (id: string) => document.getElementById(id)!;
  const fileInput = $('ps-file') as HTMLInputElement;
  const drop = $('ps-drop');
  const panel = $('ps-panel');
  const nameEl = $('ps-name');
  const pagesEl = $('ps-pages');
  const rangeWrap = $('ps-range-wrap');
  const rangeIn = $('ps-range') as HTMLInputElement;
  const err = $('ps-error');
  const status = $('ps-status');
  const loading = $('ps-loading');
  const previewWrap = $('ps-preview-wrap');
  const previewMount = $('ps-viewer');

  let files: File[] = [];
  let bytes: ArrayBuffer | null = null;
  let pageCount = 0;
  let mode = 'range';
  // Single-file only: original 0-based page indices still kept, in display order.
  let order: number[] = [];
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  const labelEls = new Map<number, HTMLElement>(); // original idx -> "Page N" label in its slot
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  async function load(picked: File[]) {
    setErr('');
    if (!picked.length) return;
    files = picked;
    bytes = await picked[0].arrayBuffer();
    previewWrap.classList.add('hidden');
    viewer?.destroy(); viewer = null; previewMount.replaceChildren();
    labelEls.clear(); order = [];
    try {
      const doc = await PDFDocument.load(bytes.slice(0));
      pageCount = doc.getPageCount();
      nameEl.textContent = picked.length === 1 ? picked[0].name : `${picked.length} PDFs`;
      pagesEl.textContent = String(pageCount);
      panel.classList.remove('hidden'); panel.classList.add('flex');
      // Thumbnails + per-page delete only make sense for a single file.
      if (picked.length === 1) await mountPreview(picked[0]);
    } catch (e) {
      console.error('[pdf-split] load failed:', e);
      setErr('Could not open that PDF: ' + (e as Error).message);
    }
  }

  // Mount the shared viewer and inject a "Page N" label + delete button into every page slot.
  async function mountPreview(file: File) {
    loading.classList.remove('hidden');
    previewWrap.classList.remove('hidden'); previewWrap.classList.add('flex');
    order = []; labelEls.clear();
    const prev = viewer;
    viewer = await mountViewer({
      file,
      mount: previewMount,
      onPage: (page, slot) => {
        const idx = page - 1;
        order.push(idx);
        // Overlay bar: page label (left) + delete button (right), pinned to the slot's top.
        const bar = document.createElement('div');
        bar.className = 'absolute inset-x-0 top-0 z-10 flex items-center gap-2 bg-black/45 px-2 py-1';
        const num = document.createElement('span');
        num.className = 'flex-1 text-xs text-white';
        const del = document.createElement('button');
        del.type = 'button'; del.setAttribute('aria-label', 'Delete page');
        del.className = 'inline-flex h-6 w-6 items-center justify-center rounded text-white hover:bg-white/20';
        del.style.color = '#ff8a8d';
        del.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>';
        del.addEventListener('click', () => removePage(idx));
        bar.append(num, del);
        slot.appendChild(bar);
        labelEls.set(idx, num);
      },
    });
    prev?.destroy();
    previewMount.replaceChildren(viewer.root);
    relabel();
    loading.classList.add('hidden');
  }

  function removePage(idx: number) {
    if (order.length <= 1) { setErr('Keep at least one page.'); return; }
    setErr('');
    order = order.filter((x) => x !== idx);
    viewer?.setPageVisible(idx + 1, false); // hide both the slot and its rail thumbnail
    labelEls.delete(idx);
    relabel();
  }

  // Renumber kept pages 1..N in display order and refresh the count.
  function relabel() {
    order.forEach((idx, pos) => { const el = labelEls.get(idx); if (el) el.textContent = `Page ${pos + 1}`; });
    pagesEl.textContent = String(order.length);
  }

  function restore() {
    if (!files.length || files.length !== 1) return;
    setErr('');
    mountPreview(files[0]);
  }

  function parseRange(str: string, count: number): number[] {
    const idx: number[] = [];
    for (const part of str.split(',')) {
      const p = part.trim();
      if (!p) continue;
      const m = p.match(/^(\d+)\s*-\s*(\d+)$/);
      if (m) { let a = +m[1], b = +m[2]; if (a > b) [a, b] = [b, a]; for (let i = a; i <= b; i++) if (i >= 1 && i <= count) idx.push(i - 1); }
      else if (/^\d+$/.test(p)) { const n = +p; if (n >= 1 && n <= count) idx.push(n - 1); }
    }
    return [...new Set(idx)];
  }

  // Produce split outputs for one source PDF (range → one file; each → N files).
  // `keep` is the list of original 0-based indices to consider, in output order.
  async function splitOne(buf: ArrayBuffer, base: string, keep: number[]): Promise<{ name: string; data: Uint8Array }[]> {
    const src = await PDFDocument.load(buf);
    if (mode === 'range') {
      const pos = parseRange(rangeIn.value, keep.length);
      if (!pos.length) throw new Error(`no pages in "${base}" match that range (1–${keep.length})`);
      const out = await PDFDocument.create();
      (await out.copyPages(src, pos.map((p) => keep[p]))).forEach((p) => out.addPage(p));
      return [{ name: `${base}-extracted.pdf`, data: await out.save() }];
    }
    const entries = [];
    for (let pos = 0; pos < keep.length; pos++) {
      const out = await PDFDocument.create();
      const [p] = await out.copyPages(src, [keep[pos]]);
      out.addPage(p);
      entries.push({ name: `${base}-page-${pos + 1}.pdf`, data: await out.save() });
    }
    return entries;
  }

  const dl = (blob: Blob, name: string) => {
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  };

  async function run() {
    if (!files.length) return;
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Working…';
    try {
      // Single file: use the kept-page order (respects manual deletes), no zip.
      if (files.length === 1) {
        const keep = order.slice();
        if (!keep.length) { status.classList.add('hidden'); setErr('Keep at least one page.'); return; }
        const src = await PDFDocument.load(bytes!);
        if (mode === 'range') {
          const pos = parseRange(rangeIn.value, keep.length);
          if (!pos.length) { status.classList.add('hidden'); setErr('Enter a valid page range within 1–' + keep.length + '.'); return; }
          const out = await PDFDocument.create();
          (await out.copyPages(src, pos.map((p) => keep[p]))).forEach((p) => out.addPage(p));
          dl(new Blob([await out.save() as BlobPart], { type: 'application/pdf' }), 'extracted.pdf');
          status.textContent = `Done — extracted ${pos.length} page(s).`;
        } else {
          const base = files[0].name.replace(/\.pdf$/i, '') || 'page';
          const entries = [];
          for (let pos = 0; pos < keep.length; pos++) {
            const out = await PDFDocument.create();
            const [p] = await out.copyPages(src, [keep[pos]]);
            out.addPage(p);
            entries.push({ name: `${base}-page-${pos + 1}.pdf`, data: await out.save() });
          }
          dl(makeZip(entries), `${base}-pages.zip`);
          status.textContent = `Done — ${keep.length} single-page PDFs in a ZIP.`;
        }
        return;
      }
      // Multiple files: split each in full (no manual delete), bundle into one ZIP.
      const all = [];
      const seen = new Set<string>();
      for (let i = 0; i < files.length; i++) {
        status.textContent = `Splitting ${i + 1}/${files.length}…`;
        const base = files[i].name.replace(/\.pdf$/i, '') || `document-${i + 1}`;
        const buf = await files[i].arrayBuffer();
        const full = (await PDFDocument.load(buf)).getPageIndices();
        for (const e of await splitOne(buf, base, full)) {
          let name = e.name;
          while (seen.has(name)) name = name.replace(/(\.pdf)$/, `-${i}$1`);
          seen.add(name);
          all.push({ name, data: e.data });
        }
      }
      dl(makeZip(all), 'split-pdfs.zip');
      status.textContent = `Done — ${all.length} file(s) from ${files.length} PDFs · ZIP.`;
    } catch (e) { status.classList.add('hidden'); setErr('Could not split: ' + (e as Error).message); }
  }

  document.querySelectorAll<HTMLButtonElement>('.ps-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      mode = tab.dataset.mode!;
      document.querySelectorAll('.ps-tab').forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', String(active));
        t.classList.toggle('btn-primary', active);
        t.classList.toggle('btn-secondary', !active);
      });
      rangeWrap.style.display = mode === 'range' ? '' : 'none';
    });
  });

  fileInput.addEventListener('change', () => { if (fileInput.files?.length) load(Array.from(fileInput.files)); });
  ['dragover', 'dragenter'].forEach((e) => drop.addEventListener(e, (ev) => { ev.preventDefault(); drop.classList.add('bg-surface-2'); }));
  ['dragleave', 'drop'].forEach((e) => drop.addEventListener(e, () => drop.classList.remove('bg-surface-2')));
  drop.addEventListener('drop', (ev) => { ev.preventDefault(); const fs = (ev as DragEvent).dataTransfer?.files; if (fs?.length) load(Array.from(fs)); });
  $('ps-reset').addEventListener('click', restore);
  bindRun($('ps-go'), run);
</script>
