---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-extract-images">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <div id="viewer-mount"></div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[13px] text-ink-subtle"><span id="name"></span> — <span id="count">0</span> image(s) found</span>
        <span class="flex-1"></span>
        <button id="zip" class="btn btn-secondary px-3 py-1.5 text-[13px]" type="button" disabled>Download all (ZIP)</button>
      </div>
      <ul id="grid" class="thumb-grid"></ul>
    </div>
    <p id="loading" class="hidden text-[13px] text-ink-subtle">Scanning pages…</p>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool extracts the raster images embedded in a PDF. It scans each page for image objects, rebuilds them as PNGs, and lets you download any one of them or all at once in a ZIP. It pulls out genuinely embedded photos and graphics — not vector drawings or text.</p>
  </div>
</ToolLayout>

<style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }</style>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { setupDrop, download, working, bindRun } from '../lib/pdfui';
  import { makeZip } from '../lib/zip';
  import { mountViewer } from '../lib/pdfViewer';
  pdfjsLib.GlobalWorkerOptions.workerSrc = workerUrl;

  // A very image-heavy PDF can hold more decoded bitmaps than a phone will allow. Stop at a cap and
  // say so, rather than filling memory until the tab is killed.
  const MAX_IMAGES = window.innerWidth < 640 ? 120 : 500;

  const $ = (id: string) => document.getElementById(id)!;
  const panel = $('panel'), grid = $('grid') as HTMLUListElement;
  const mount = $('viewer-mount');
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  const err = $('error'), status = $('status'), loading = $('loading');
  let fname = 'document.pdf';
  let found: { name: string; blob: Blob; url: string }[] = [];
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  // Turn a pdf.js image object into a canvas we can encode as PNG.
  function imgToCanvas(img: any): HTMLCanvasElement | null {
    const { width, height } = img;
    if (!width || !height) return null;
    const canvas = document.createElement('canvas');
    canvas.width = width; canvas.height = height;
    const ctx = canvas.getContext('2d')!;
    // Newer pdf.js hands back an ImageBitmap directly.
    if (typeof ImageBitmap !== 'undefined' && img.bitmap instanceof ImageBitmap) {
      ctx.drawImage(img.bitmap, 0, 0); return canvas;
    }
    const src: Uint8ClampedArray | undefined = img.data;
    if (!src) return null;
    const out = ctx.createImageData(width, height);
    const dst = out.data;
    const kind = img.kind; // 1=GRAYSCALE_1BPP-decoded to 8bpp, 2=RGB_24BPP, 3=RGBA_32BPP
    if (kind === 3 || src.length === width * height * 4) {
      dst.set(src.subarray(0, dst.length));
    } else if (kind === 2 || src.length === width * height * 3) {
      for (let i = 0, j = 0; i < src.length; i += 3, j += 4) { dst[j] = src[i]; dst[j + 1] = src[i + 1]; dst[j + 2] = src[i + 2]; dst[j + 3] = 255; }
    } else {
      // Grayscale (one byte per pixel).
      for (let i = 0, j = 0; i < src.length; i++, j += 4) { dst[j] = dst[j + 1] = dst[j + 2] = src[i]; dst[j + 3] = 255; }
    }
    ctx.putImageData(out, 0, 0);
    return canvas;
  }

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    found.forEach((f) => URL.revokeObjectURL(f.url));
    found = []; grid.innerHTML = '';
    fname = files[0].name.replace(/\.pdf$/i, '');
    $('name').textContent = files[0].name;
    panel.classList.remove('hidden'); panel.classList.add('flex');
    try {
      viewer = await mountViewer({ file: files[0], mount, replaces: viewer });
      mount.replaceChildren(viewer.root);
    } catch (e) { console.error('[pdf-extract-images] preview failed:', e); }
    loading.classList.remove('hidden');
    loading.textContent = 'Scanning pages…';
    working($('zip'), true, 'Scanning…');
    let task: ReturnType<typeof pdfjsLib.getDocument> | null = null;
    try {
      const buf = (await files[0].arrayBuffer()).slice(0);
      task = pdfjsLib.getDocument({ data: buf });
      const pdf = await task.promise;
      const OPS = (pdfjsLib as any).OPS;
      const seen = new Set<string>();
      let capped = false;
      for (let n = 1; n <= pdf.numPages && !capped; n++) {
        loading.textContent = `Scanning page ${n} of ${pdf.numPages}… ${found.length} image(s) found`;
        const page = await pdf.getPage(n);
        const ops = await page.getOperatorList();
        for (let i = 0; i < ops.fnArray.length; i++) {
          const fn = ops.fnArray[i];
          if (fn !== OPS.paintImageXObject && fn !== OPS.paintInlineImageXObject) continue;
          const arg = ops.argsArray[i][0];
          // Key on the object id alone, not per-page: a logo repeated on 400 pages is one image, and
          // re-extracting it per page is most of why a large file never finished.
          const key = typeof arg === 'string' ? arg : `${n}:inline:${i}`;
          if (seen.has(key)) continue; seen.add(key);
          const img = typeof arg === 'string' ? await getObj(page, arg) : arg;
          if (!img) continue;
          const canvas = imgToCanvas(img);
          if (!canvas) continue;
          const blob = await new Promise<Blob | null>((res) => canvas.toBlob(res, 'image/png'));
          canvas.width = canvas.height = 0; // release the backing store now, not at the next GC
          if (!blob) continue;
          const name = `${fname}-p${n}-img${found.length + 1}.png`;
          const url = URL.createObjectURL(blob);
          found.push({ name, blob, url });
          addCard(url, name, img.width, img.height);
          if (found.length >= MAX_IMAGES) { capped = true; break; }
        }
        page.cleanup();
        // Yield between pages: without this the whole scan is one long task, so nothing repaints
        // (the progress line looks frozen) and the browser can't reclaim the last page's bitmaps.
        await new Promise((r) => setTimeout(r, 0));
      }
      loading.classList.add('hidden');
      $('count').textContent = String(found.length);
      working($('zip'), false);
      ($('zip') as HTMLButtonElement).disabled = found.length === 0;
      if (capped) setErr(`Stopped at ${MAX_IMAGES} images to stay within this device's memory. Extracted the first ${MAX_IMAGES}.`);
      else if (!found.length) setErr('No embedded raster images found. Vector graphics and text are not extracted.');
    } catch (e) {
      loading.classList.add('hidden');
      working($('zip'), false);
      ($('zip') as HTMLButtonElement).disabled = true;
      setErr('Could not read that PDF: ' + (e as Error).message);
    } finally {
      task?.destroy().catch(() => {}); // frees the worker's copy of the document
    }
  }

  // Resolve a pdf.js image XObject.
  //
  // objs.get(id, cb) INSERTS a pending entry and only settles when the worker sends that object — but
  // an image reused across pages is sent to `commonObjs` instead, so the page-store promise never
  // settles and never rejects. Awaiting it froze the whole scan on the first shared image, which is
  // why a large PDF produced nothing at all. Check both stores, and never wait forever.
  async function getObj(page: any, id: string): Promise<any> {
    for (const store of [page.objs, page.commonObjs]) {
      try { if (store?.has?.(id)) return store.get(id); } catch { /* not resolved yet */ }
    }
    return Promise.race([
      new Promise<any>((res) => page.objs.get(id, res)),
      new Promise<null>((res) => setTimeout(() => res(null), 3000)),
    ]);
  }

  function addCard(url: string, name: string, w: number, h: number) {
    const li = document.createElement('li');
    li.className = 'panel panel-lift overflow-hidden p-2 flex flex-col gap-2';
    li.innerHTML = `<img src="${url}" class="w-full rounded" style="background:#fff" alt="${name}" />
      <span class="text-xs text-ink-tertiary">${w}×${h}</span>`;
    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'btn btn-secondary px-2 py-1 text-[13px]'; btn.textContent = 'Download';
    // Via download(): a detached anchor's .click() is ignored by iOS Safari, so these did nothing on a phone.
    btn.addEventListener('click', () => { const f = found.find((x) => x.url === url); if (f) download(f.blob, name, 'image/png'); });
    li.appendChild(btn);
    grid.appendChild(li);
  }

  bindRun($('zip'), async () => {
    if (!found.length) return;
    const entries = await Promise.all(found.map(async (f) => ({ name: f.name, data: new Uint8Array(await f.blob.arrayBuffer()) })));
    download(new Blob([makeZip(entries) as BlobPart], { type: 'application/zip' }), `${fname}-images.zip`);
  }, 'Zipping…');

  setupDrop($('dz'), $('file') as HTMLInputElement, load);
</script>
