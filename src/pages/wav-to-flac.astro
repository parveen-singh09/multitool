---
import ToolLayout from '../layouts/ToolLayout.astro';
import AudioConvert from '../components/AudioConvert.astro';
---

<ToolLayout slug="wav-to-flac">
  <AudioConvert slug="wav-to-flac" from="wav" to="flac" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free WAV to FLAC converter losslessly compresses uncompressed WAV audio into FLAC, cutting file size roughly in half with no quality loss.
    </p>
    <p>
      Conversion uses ffmpeg compiled to WebAssembly. Convert one file or
      a whole batch and download the results individually or as a ZIP.
    </p>
  </div>
</ToolLayout>
