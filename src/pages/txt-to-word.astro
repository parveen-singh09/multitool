---
import ToolLayout from '../layouts/ToolLayout.astro';
import DocConvert from '../components/DocConvert.astro';
---

<ToolLayout slug="txt-to-word">
  <DocConvert slug="txt-to-word" outLabel="Word" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free TXT to Word converter converts plain text into an editable Microsoft Word (.docx) document.
    </p>
    <p>
      Paste your content or attach a file, click Convert, then download or copy the result.
    </p>
  </div>
</ToolLayout>
