---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-n-up">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <p class="text-[13px] text-ink-subtle"><span id="name"></span> — <span id="pages">0</span> pages</p>
      <div class="flex flex-wrap items-end gap-4">
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Pages per sheet
          <select id="nup" class="field w-32"><option value="2">2</option><option value="4">4</option><option value="6">6</option><option value="8">8</option><option value="9">9</option><option value="16">16</option></select>
        </label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Orientation
          <select id="orient" class="field w-36"><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select>
        </label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Gap (pt)<input id="gap" type="number" value="10" min="0" max="60" class="field w-24" /></label>
      </div>
      <button id="go" class="btn btn-primary w-fit">Download</button>
      <div id="viewer-mount"></div>
    </div>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free N-up tool arranges several PDF pages onto one larger sheet — 2, 4, 6, 8, 9 or 16 per page — laid out in a grid. It is handy for saving paper, making printed handouts, or reviewing many pages at once. Each source page is scaled to fit its cell while keeping proportions.</p>
  </div>
</ToolLayout>

<style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }</style>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { setupDrop, download } from '../lib/pdfui';
  import { mountViewer } from '../lib/pdfViewer';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const panel = document.getElementById('panel')!, err = document.getElementById('error')!, status = document.getElementById('status')!;
  const mount = document.getElementById('viewer-mount')!;
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf';
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  // Grid columns per N. Rows derive from ceil(N/cols).
  const COLS: Record<number, number> = { 2: 1, 4: 2, 6: 2, 8: 2, 9: 3, 16: 4 };

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      const doc = await PDFDocument.load(bytes.slice(0));
      document.getElementById('name')!.textContent = files[0].name;
      document.getElementById('pages')!.textContent = String(doc.getPageCount());
      panel.classList.remove('hidden'); panel.classList.add('flex');
      renderPreview();
    } catch (e) {
      console.error('[pdf-n-up] load failed:', e);
      setErr('Could not open that PDF: ' + (e as Error).message);
    }
  }

  // Build the N-up PDF bytes. Shared by the live preview and the download.
  async function build(): Promise<{ bytes: Uint8Array; sheets: number; total: number; n: number } | null> {
    if (!bytes) return null;
    const src = await PDFDocument.load(bytes.slice(0));
    const out = await PDFDocument.create();
    const n = +$('nup').value;
    const landscape = $('orient').value === 'landscape';
    const gap = Math.max(0, +$('gap').value || 0);
    // A4 in points; swap for landscape.
    const SW = landscape ? 842 : 595, SH = landscape ? 595 : 842;
    const cols = COLS[n], rows = Math.ceil(n / cols);
    const M = 20;
    const cellW = (SW - 2 * M - (cols - 1) * gap) / cols;
    const cellH = (SH - 2 * M - (rows - 1) * gap) / rows;

    const total = src.getPageCount();
    const embedded = await out.embedPages(src.getPages());
    for (let start = 0; start < total; start += n) {
      const sheet = out.addPage([SW, SH]);
      for (let k = 0; k < n && start + k < total; k++) {
        const ep = embedded[start + k];
        const col = k % cols, row = Math.floor(k / cols);
        const scale = Math.min(cellW / ep.width, cellH / ep.height);
        const w = ep.width * scale, h = ep.height * scale;
        const cellX = M + col * (cellW + gap);
        // Rows fill top-to-bottom, but PDF y-origin is bottom-left.
        const cellY = SH - M - (row + 1) * cellH - row * gap;
        sheet.drawPage(ep, { x: cellX + (cellW - w) / 2, y: cellY + (cellH - h) / 2, width: w, height: h });
      }
    }
    return { bytes: await out.save(), sheets: out.getPageCount(), total, n };
  }

  async function run() {
    if (!bytes) return;
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Building…';
    try {
      const out = await build();
      if (!out) return;
      download(out.bytes, `${fname}-${out.n}up.pdf`);
      status.textContent = `Done — ${out.sheets} sheet(s) from ${out.total} page(s).`;
    } catch (e) { status.classList.add('hidden'); setErr('Could not build: ' + (e as Error).message); }
  }

  // Debounced full-document preview: build the N-up PDF, then mount the viewer on the result.
  let seq = 0, timer: ReturnType<typeof setTimeout> | null = null;
  async function renderPreview() {
    if (!bytes) return;
    const my = ++seq;
    try {
      const out = await build();
      const data = out ? out.bytes : new Uint8Array(bytes.slice(0));
      if (my !== seq) return;
      const prev = viewer;
      viewer = await mountViewer({ file: new File([data as BlobPart], 'preview.pdf', { type: 'application/pdf' }) });
      if (my !== seq) { viewer.destroy(); return; } // superseded by a newer render
      prev?.destroy();
      mount.replaceChildren(viewer.root);
    } catch (e) { console.error('[pdf-n-up] preview failed:', e); }
  }
  const schedule = () => { if (timer) clearTimeout(timer); timer = setTimeout(renderPreview, 400); };

  setupDrop(document.getElementById('dz')!, $('file'), load);
  panel.addEventListener('input', schedule);
  panel.addEventListener('change', schedule);
  document.getElementById('go')!.addEventListener('click', run);
</script>
