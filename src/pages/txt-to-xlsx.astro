---
import ToolLayout from '../layouts/ToolLayout.astro';
import DocConvert from '../components/DocConvert.astro';
---

<ToolLayout slug="txt-to-xlsx">
  <DocConvert slug="txt-to-xlsx" outLabel="Excel" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free TXT to Excel converter converts plain text into a Microsoft Excel (.xlsx) spreadsheet.    </p>
    <p>
      Paste your content or attach a file, click Convert, then download or copy the result.
    </p>
  </div>
</ToolLayout>
