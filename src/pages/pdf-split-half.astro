---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-split-half">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <p class="text-[13px] text-ink-subtle"><span id="name"></span> — <span id="pages">0</span> pages. Split after page <span id="mid">0</span>.</p>
      <button id="go" class="btn btn-primary w-fit">Split in half</button>
      <div id="viewer-mount"></div>
    </div>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool splits a PDF into two equal halves at its midpoint. You get two files — the first half and the second half — downloaded together as a ZIP. For an odd page count the first half takes the extra page. Useful for separating a document that was scanned or assembled at double length.</p>
  </div>
</ToolLayout>

<style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }</style>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { setupDrop, download, bindRun } from '../lib/pdfui';
  import { makeZip } from '../lib/zip';
  import { mountViewer } from '../lib/pdfViewer';

  const $ = (id: string) => document.getElementById(id)!;
  const panel = $('panel'), err = $('error'), status = $('status');
  const mount = document.getElementById('viewer-mount')!;
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf', count = 0;
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      const doc = await PDFDocument.load(bytes.slice(0));
      count = doc.getPageCount();
      $('name').textContent = files[0].name;
      $('pages').textContent = String(count);
      $('mid').textContent = String(Math.ceil(count / 2));
      panel.classList.remove('hidden'); panel.classList.add('flex');
      viewer?.destroy();
      viewer = await mountViewer({ file: files[0] });
      mount.replaceChildren(viewer.root);
    } catch (e) {
      console.error('[pdf-split-half] load failed:', e);
      setErr('Could not open that PDF: ' + (e as Error).message);
    }
  }

  async function half(src: PDFDocument, from: number, to: number): Promise<Uint8Array> {
    const out = await PDFDocument.create();
    const idx = []; for (let i = from; i < to; i++) idx.push(i);
    (await out.copyPages(src, idx)).forEach((p) => out.addPage(p));
    return out.save();
  }

  async function run() {
    if (!bytes) return;
    if (count < 2) { setErr('Need at least 2 pages to split.'); return; }
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Splitting…';
    try {
      const src = await PDFDocument.load(bytes);
      const mid = Math.ceil(count / 2);
      const zip = makeZip([
        { name: `${fname}-part1.pdf`, data: await half(src, 0, mid) },
        { name: `${fname}-part2.pdf`, data: await half(src, mid, count) },
      ]);
      download(new Blob([zip as BlobPart], { type: 'application/zip' }), `${fname}-halves.zip`);
      status.textContent = `Done — pages 1–${mid} and ${mid + 1}–${count}.`;
    } catch (e) { status.classList.add('hidden'); setErr('Could not split: ' + (e as Error).message); }
  }

  setupDrop($('dz'), $('file') as HTMLInputElement, load);
  bindRun($('go'), run);
</script>
