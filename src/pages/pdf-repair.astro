---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-repair">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[13px] text-ink-subtle"><span id="name"></span></span>
        <span class="flex-1"></span>
        <button id="go" class="btn btn-primary" type="button">Repair & preview</button>
        <button id="dl" class="btn btn-secondary hidden" type="button">Download</button>
      </div>
      <div id="viewer-mount"></div>
    </div>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool attempts to repair a damaged or malformed PDF. It re-parses the file and rebuilds its internal structure — cross-reference tables and object streams — so viewers that refused to open it may work again. Repair is best-effort: it fixes structural problems, not missing or truncated content.</p>
  </div>
</ToolLayout>

<style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }</style>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { setupDrop, download, bindRun } from '../lib/pdfui';
  import { mountViewer } from '../lib/pdfViewer';

  const $ = (id: string) => document.getElementById(id)!;
  const panel = $('panel'), err = $('error'), status = $('status'), mount = document.getElementById('viewer-mount')!;
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf';
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  let outBytes: Uint8Array | null = null; // repaired bytes, held for the Download button
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      $('name').textContent = files[0].name;
      panel.classList.remove('hidden'); panel.classList.add('flex');
      // Reset any prior run's preview/download. Don't mount the viewer on the source —
      // a broken input is exactly what this tool exists for; we only preview the repaired output.
      outBytes = null; viewer?.destroy(); viewer = null; mount.replaceChildren();
      $('dl').classList.add('hidden');
    } catch (e) {
      console.error('[pdf-repair] load failed:', e);
      setErr('Could not open that PDF: ' + (e as Error).message);
    }
  }

  async function run() {
    if (!bytes) return;
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Repairing…';
    try {
      // throwOnInvalidObject:false lets pdf-lib skip over malformed objects; re-saving rewrites a clean xref.
      const doc = await PDFDocument.load(bytes.slice(0), { throwOnInvalidObject: false, updateMetadata: false });
      outBytes = await doc.save({ useObjectStreams: true });
      const pages = doc.getPageCount();
      $('dl').classList.remove('hidden');
      status.textContent = `Done — rebuilt ${pages} page(s). Preview below.`;
      // The repaired output may still be too damaged to render; a failed preview must not hide the download.
      try {
        const prev = viewer;
        viewer = await mountViewer({ file: new File([outBytes as BlobPart], `${fname}-repaired.pdf`, { type: 'application/pdf' }) });
        prev?.destroy();
        mount.replaceChildren(viewer.root);
      } catch (e) {
        console.error('[pdf-repair] preview failed:', e);
        status.textContent = `Done — rebuilt ${pages} page(s). Preview unavailable; download to open it.`;
      }
    } catch (e) {
      status.classList.add('hidden');
      setErr('Could not repair this file: ' + (e as Error).message + '. The damage may be too severe, or the PDF is encrypted.');
    }
  }

  setupDrop($('dz'), $('file') as HTMLInputElement, load);
  bindRun($('go'), run);
  $('dl').addEventListener('click', () => { if (outBytes) download(outBytes, `${fname}-repaired.pdf`); });
</script>
