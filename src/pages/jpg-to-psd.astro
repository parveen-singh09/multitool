---
import ToolLayout from '../layouts/ToolLayout.astro';
import RasterBatch from '../components/RasterBatch.astro';
---

<ToolLayout slug="jpg-to-psd">
  <RasterBatch to="psd" accept="image/jpeg,.jpg,.jpeg,.jfif" fromLabel="JPG" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free JPG to PSD converter writes each JPG as an uncompressed Adobe Photoshop (.psd) file with a flattened RGBA composite that opens in Photoshop, Photopea and GIMP.
    </p>
    <p>
      Drop a single image or a whole batch at once, optionally resize by the longest side,
      and preview each result before you download.
    </p>
  </div>
</ToolLayout>
