---
import ToolLayout from '../layouts/ToolLayout.astro';
import RasterBatch from '../components/RasterBatch.astro';
---

<ToolLayout slug="jpg-to-svg">
  <RasterBatch to="svg" accept="image/jpeg,.jpg,.jpeg,.jfif" fromLabel="JPG" />

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>
      This free JPG to SVG converter wraps each JPG inside an SVG <code>&lt;image&gt;</code> element so it embeds into vector workflows and scales without markup changes. This is an embed, not an autotrace — pixels stay pixels.
    </p>
    <p>
      Drop a single image or a whole batch at once, optionally resize by the longest side,
      and preview each result before you download.
    </p>
  </div>
</ToolLayout>
