---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout slug="pdf-metadata">
  <div class="flex flex-col gap-4">
    <label id="dz" class="panel panel-lift flex cursor-pointer flex-col items-center justify-center gap-2 border-dashed p-8 text-center transition-colors hover:bg-surface-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-tertiary" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      <span class="text-sm text-ink">Choose a PDF or drop it here</span>
      <input id="file" type="file" accept="application/pdf" class="sr-only" />
    </label>

    <div id="panel" class="hidden flex-col gap-4">
      <p class="text-[13px] text-ink-subtle"><span id="name"></span></p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Title<input id="m-title" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Author<input id="m-author" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Subject<input id="m-subject" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Keywords (comma separated)<input id="m-keywords" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Creator<input id="m-creator" type="text" class="field" /></label>
        <label class="flex flex-col gap-1 text-[13px] text-ink-subtle">Producer<input id="m-producer" type="text" class="field" /></label>
      </div>
      <button id="go" class="btn btn-primary w-fit">Save metadata</button>
      <div id="viewer-mount"></div>
    </div>
    <p id="error" class="hidden text-[13px]" style="color:#e5484d" role="alert"></p>
    <p id="status" class="hidden text-[13px] text-ink-subtle"></p>
  </div>

  <div slot="about" class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
    <p>This free tool reads and edits the document properties of a PDF — title, author, subject, keywords, creator and producer. Load a file to see its current metadata, change any field, and download the updated PDF.</p>
  </div>
</ToolLayout>

<style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }</style>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { setupDrop, download, bindRun } from '../lib/pdfui';
  import { mountViewer } from '../lib/pdfViewer';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const panel = document.getElementById('panel')!, err = document.getElementById('error')!, status = document.getElementById('status')!;
  const mount = document.getElementById('viewer-mount')!;
  let bytes: ArrayBuffer | null = null, fname = 'document.pdf';
  let viewer: Awaited<ReturnType<typeof mountViewer>> | null = null;
  const setErr = (m: string) => { err.textContent = m; err.classList.toggle('hidden', !m); };

  async function load(files: File[]) {
    setErr('');
    if (!files.length) return;
    try {
      bytes = await files[0].arrayBuffer();
      fname = files[0].name.replace(/\.pdf$/i, '');
      const doc = await PDFDocument.load(bytes.slice(0));
      document.getElementById('name')!.textContent = files[0].name;
      $('m-title').value = doc.getTitle() ?? '';
      $('m-author').value = doc.getAuthor() ?? '';
      $('m-subject').value = doc.getSubject() ?? '';
      $('m-keywords').value = (doc.getKeywords() ?? '');
      $('m-creator').value = doc.getCreator() ?? '';
      $('m-producer').value = doc.getProducer() ?? '';
      panel.classList.remove('hidden'); panel.classList.add('flex');
      viewer?.destroy();
      viewer = await mountViewer({ file: files[0] });
      mount.replaceChildren(viewer.root);
    } catch (e) {
      console.error('[pdf-metadata] load failed:', e);
      setErr('Could not open that PDF: ' + (e as Error).message);
    }
  }

  async function run() {
    if (!bytes) return;
    setErr(''); status.classList.remove('hidden'); status.textContent = 'Saving…';
    try {
      const doc = await PDFDocument.load(bytes);
      doc.setTitle($('m-title').value);
      doc.setAuthor($('m-author').value);
      doc.setSubject($('m-subject').value);
      doc.setKeywords($('m-keywords').value.split(',').map((k) => k.trim()).filter(Boolean));
      doc.setCreator($('m-creator').value);
      doc.setProducer($('m-producer').value);
      download(await doc.save(), `${fname}-metadata.pdf`);
      status.textContent = 'Done — metadata updated.';
    } catch (e) { status.classList.add('hidden'); setErr('Could not save: ' + (e as Error).message); }
  }

  setupDrop(document.getElementById('dz')!, $('file'), load);
  bindRun(document.getElementById('go')!, run);
</script>
