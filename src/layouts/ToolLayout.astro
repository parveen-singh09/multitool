---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import { getTool, tools, type Tool } from '../data/tools';
import { TOOL_CONTENT } from '../data/toolContent';
import { SITE } from '../data/site';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = getTool(slug) as Tool;
if (!tool) throw new Error(`Unknown tool slug: ${slug}`);

const pageUrl = `${SITE.url}/${tool.slug}`;
const content = TOOL_CONTENT[slug]; // undefined for tools without rich content yet

// Same-category tools first (most relevant + strongest topical signal), then
// fill from other categories. 12 links per page ~doubles the internal crawl
// paths into the 605 tools vs the old 6 — helps Google justify crawling deeper.
const related = [
  ...tools.filter((t) => t.slug !== tool.slug && t.category === tool.category),
  ...tools.filter((t) => t.slug !== tool.slug && t.category !== tool.category),
].slice(0, 12);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `${tool.name} — ${SITE.name}`,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    url: pageUrl,
    description: tool.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools` },
      { '@type': 'ListItem', position: 3, name: tool.name, item: pageUrl },
    ],
  },
];

// FAQPage rich result — only when this tool has real FAQ content.
if (content?.faqs?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Layout
  title={tool.name}
  description={tool.description}
  keywords={tool.keywords}
  jsonLd={jsonLd}
>
  <Header />

  <main class="container-page py-10 md:py-14">

    <div>
      <div class="flex flex-col gap-3">
        <span class="eyebrow text-primary-hover">{tool.category}</span>
        <h1 class="display-md text-ink">{tool.name}</h1>
        {!tool.hideTagline && <p class="text-lg leading-relaxed text-ink-muted">{tool.tagline}</p>}
      </div>


      <div class="mt-8">
        <slot />
      </div>


      <div class="mt-10 border-t border-hairline pt-8">
        <slot name="about">
          <p class="text-[15px] leading-relaxed text-ink-subtle">{tool.description}</p>
        </slot>
      </div>

      {content?.steps?.length && (
        <div class="mt-12">
          <h2 class="mb-5 font-display text-lg font-semibold text-ink">How to use</h2>
          <ol class="flex flex-col gap-3">
            {content.steps.map((step, i) => (
              <li class="flex gap-3 text-[15px] leading-relaxed text-ink-muted">
                <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full border border-hairline-strong text-[13px] font-medium text-ink-subtle">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      {content?.body?.length && (
        <div class="mt-12">
          <h2 class="mb-4 font-display text-lg font-semibold text-ink">About {tool.name}</h2>
          <div class="flex flex-col gap-4 text-[15px] leading-relaxed text-ink-subtle">
            {content.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
      )}

      {content?.faqs?.length && (
        <div class="mt-12">
          <h2 class="mb-5 font-display text-lg font-semibold text-ink">Frequently asked questions</h2>
          <div class="flex flex-col gap-3">
            {content.faqs.map((f) => (
              <details class="group rounded-lg border border-hairline bg-surface-1 px-5 py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-ink [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <svg class="h-4 w-4 flex-none text-ink-subtle transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                </summary>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>


    <section class="mt-16">
      <h2 class="mb-5 font-display text-lg font-semibold text-ink">Related tools</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => <ToolCard tool={r} />)}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
