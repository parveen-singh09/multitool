https://toolsilk.pages.dev/*
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Astro emits content-hashed filenames here — the hash changes when content
# changes, so these are immutable. Cache a year instead of revalidating every 4h.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are stable. If you ever swap one, rename the file (the URL is referenced
# in one @font-face) so the year-long cache doesn't serve the old glyphs.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
